{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./cchook/interceptor.exe"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./cchook/interceptor.exe"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|View|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "./cchook/interceptor.exe"
          }
        ]
      }
    ]
  }
}